// Prisma schema for auth-related tables (v2). Uses existing DB tables via @@map.
// Run: npx prisma generate (no migrate - tables already exist from 0007_authentication).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  fullName     String?   @map("full_name")
  role         String    @default("member") // owner | member
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  sessions         UserSession[]
  apiKeys          ApiKey[]
  workspacesOwned  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  agentMembers     AgentMember[]

  @@map("users")
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String   @map("name")
  plan      String   @default("free") @map("plan")
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  agents    Agent[]
  websiteCrawls WebsiteCrawl[]
  agentDocuments AgentDocument[]
  agentQaEntries AgentQa[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  userId      Int      @map("user_id")
  role        String   @default("member") // owner | member
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Agent {
  id           Int      @id @default(autoincrement())
  workspaceId  Int      @map("workspace_id")
  name         String   @map("name")
  model        String?  @map("model")
  prePrompt    String?  @map("pre_prompt")
  logoUrl      String?  @map("logo_url")
  widgetConfig Json?    @map("widget_config")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        AgentMember[]
  websiteCrawls  WebsiteCrawl[]
  documents      AgentDocument[]
  documentChunks AgentDocumentChunk[]
  qaEntries      AgentQa[]

  @@map("agents")
}

model AgentDocument {
  id           Int       @id @default(autoincrement())
  agentId      Int       @map("agent_id")
  workspaceId  Int       @map("workspace_id")
  fileName     String    @map("file_name")
  fileSize     BigInt    @map("file_size")
  mimeType     String    @map("mime_type")
  status       String    @default("pending") // pending | processing | ready | failed
  errorMessage String?   @map("error_message")
  chunkCount   Int       @default(0) @map("chunk_count")
  content      String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  agent   Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks  AgentDocumentChunk[]

  @@map("agent_documents")
}

model AgentDocumentChunk {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  agentId    Int      @map("agent_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  tokenCount Int      @default(0) @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")

  document AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agent    Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_document_chunks")
}

model AgentQa {
  id           Int       @id @default(autoincrement())
  agentId      Int       @map("agent_id")
  workspaceId  Int       @map("workspace_id")
  question     String    @db.Text
  answer       String    @db.Text
  timesAsked   Int       @default(0) @map("times_asked")
  lastAskedAt  DateTime? @map("last_asked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  agent   Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageEvents AgentQaUsage[]

  @@map("agent_qa")
}

model AgentQaUsage {
  id      Int      @id @default(autoincrement())
  qaId    Int      @map("qa_id")
  askedAt DateTime @default(now()) @map("asked_at")

  qa AgentQa @relation(fields: [qaId], references: [id], onDelete: Cascade)

  @@map("agent_qa_usage")
}

model WebsiteCrawl {
  id              Int      @id @default(autoincrement())
  workspaceId     Int      @map("workspace_id")
  agentId         Int?     @map("agent_id")
  url             String   @map("url")
  title           String?  @map("title")
  description     String?  @map("description")
  logoUrl         String?  @map("logo_url")
  useCase         String   @default("general") @map("use_case")
  trainingContent String   @map("training_content")
  metadata        Json     @default("{}") @map("metadata")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@map("website_crawls")
}

model AgentMember {
  id        Int      @id @default(autoincrement())
  agentId   Int      @map("agent_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@map("agent_members")
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  sessionToken String   @unique @map("session_token")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  keyHash    String    @unique @map("key_hash")
  name       String    @map("name")
  permissions String[] @default([])
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}
