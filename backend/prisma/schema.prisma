// Prisma schema for auth-related tables (v2). Uses existing DB tables via @@map.
// Run: npx prisma generate (no migrate - tables already exist from 0007_authentication).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  fullName     String?   @map("full_name")
  role         String    @default("member") // owner | member
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  sessions              UserSession[]
  apiKeys               ApiKey[]
  workspacesOwned       Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers      WorkspaceMember[]
  workspaceInvitesSent  WorkspaceInvite[]
  agentMembers          AgentMember[]
  createdWorkspaceApiKeys WorkspaceApiKey[]

  @@map("users")
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String   @map("name")
  plan      String   @default("free") @map("plan") // denormalized from subscription for quick checks
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  owner         User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  agents        Agent[]
  websiteCrawls WebsiteCrawl[]
  agentDocuments AgentDocument[]
  agentQaEntries AgentQa[]
  subscription  WorkspaceSubscription?
  credits       WorkspaceCredits?
  workspaceApiKeys WorkspaceApiKey[]
  billingTransactions WorkspaceBillingTransaction[]
  agentActions     AgentAction[]

  @@map("workspaces")
}

model WorkspaceInvite {
  id              Int      @id @default(autoincrement())
  workspaceId     Int      @map("workspace_id")
  email           String   @map("email")
  token           String   @unique @map("token")
  invitedByUserId Int      @map("invited_by_user_id")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}

model WorkspaceMember {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  userId      Int      @map("user_id")
  role        String   @default("member") // owner | member
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Agent {
  id           Int      @id @default(autoincrement())
  workspaceId  Int      @map("workspace_id")
  name         String   @map("name")
  model        String?  @map("model")
  prePrompt    String?  @map("pre_prompt")
  logoUrl      String?  @map("logo_url")
  role         String?  @default("general") @map("role") // general | support | sales
  widgetConfig Json?    @map("widget_config")
  integrations Json?    @map("integrations") // { slack?: { accessToken?, teamId?, teamName? }, ... }
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        AgentMember[]
  websiteCrawls  WebsiteCrawl[]
  documents      AgentDocument[]
  documentChunks AgentDocumentChunk[]
  qaEntries      AgentQa[]
  chatSessions   AgentChatSession[]
  chatMessages   AgentChatMessage[]
  actions       AgentAction[]

  @@map("agents")
}

model AgentAction {
  id          Int      @id @default(autoincrement())
  agentId     Int      @map("agent_id")
  workspaceId Int      @map("workspace_id")
  type        String   @map("type") // custom_api | web_search | collect_leads | escalate | calendly | cal_com | shopify | stripe | salesforce | slack | custom_button
  name        String   @map("name")
  description String?  @map("description")
  enabled     Boolean  @default(true) @map("enabled")
  config      Json?    @map("config") // type-specific: endpoint, method, inputs, whenToUse, etc.
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([workspaceId])
  @@map("agent_actions")
}

model AgentChatSession {
  id        Int      @id @default(autoincrement())
  agentId   Int      @map("agent_id")
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  agent   Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages AgentChatMessage[]

  @@unique([agentId, sessionId])
  @@map("agent_chat_sessions")
}

model AgentChatMessage {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  agentId     Int      @map("agent_id")
  role        String   // 'user' | 'assistant'
  content     String   @db.Text
  creditsUsed Int      @default(0) @map("credits_used") // message credits consumed for this response
  createdAt   DateTime @default(now()) @map("created_at")

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_chat_messages")
}

model AgentDocument {
  id           Int       @id @default(autoincrement())
  agentId      Int       @map("agent_id")
  workspaceId  Int       @map("workspace_id")
  fileName     String    @map("file_name")
  fileSize     BigInt    @map("file_size")
  mimeType     String    @map("mime_type")
  status       String    @default("pending") // pending | processing | ready | failed
  errorMessage String?   @map("error_message")
  chunkCount       Int       @default(0) @map("chunk_count")
  trainedLinkCount Int?      @map("trained_link_count")
  content          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  agent   Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks  AgentDocumentChunk[]

  @@map("agent_documents")
}

model AgentDocumentChunk {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  agentId    Int      @map("agent_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  tokenCount Int      @default(0) @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")

  document AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agent    Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_document_chunks")
}

model AgentQa {
  id           Int       @id @default(autoincrement())
  agentId      Int       @map("agent_id")
  workspaceId  Int       @map("workspace_id")
  question     String    @db.Text
  answer       String    @db.Text
  timesAsked   Int       @default(0) @map("times_asked")
  lastAskedAt  DateTime? @map("last_asked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  agent   Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageEvents AgentQaUsage[]

  @@map("agent_qa")
}

model AgentQaUsage {
  id      Int      @id @default(autoincrement())
  qaId    Int      @map("qa_id")
  askedAt DateTime @default(now()) @map("asked_at")

  qa AgentQa @relation(fields: [qaId], references: [id], onDelete: Cascade)

  @@map("agent_qa_usage")
}

model WebsiteCrawl {
  id              Int      @id @default(autoincrement())
  workspaceId     Int      @map("workspace_id")
  agentId         Int?     @map("agent_id")
  url             String   @map("url")
  title           String?  @map("title")
  description     String?  @map("description")
  logoUrl         String?  @map("logo_url")
  useCase         String   @default("general") @map("use_case")
  trainingContent String   @map("training_content")
  metadata        Json     @default("{}") @map("metadata")
  pagesCrawled    Int      @default(1) @map("pages_crawled")
  crawledPages    Json     @default("[]") @map("crawled_pages")
  products        Json     @default("[]") @map("products")
  supportLinks    Json     @default("[]") @map("support_links")
  navLinks        Json     @default("[]") @map("nav_links")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@map("website_crawls")
}

model AgentMember {
  id        Int      @id @default(autoincrement())
  agentId   Int      @map("agent_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@map("agent_members")
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  sessionToken String   @unique @map("session_token")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  keyHash    String    @unique @map("key_hash")
  name       String    @map("name")
  permissions String[] @default([])
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ——— Pricing & plans (workspace-level) ———

model Plan {
  id                   String   @id @default(cuid())
  name                 String   @unique // free | hobby | standard | pro | enterprise
  displayName          String   @map("display_name")
  priceMonthly         Float    @map("price_monthly")
  priceYearly          Float    @map("price_yearly")
  messageCredits       Int      @map("message_credits") // per month
  maxAgents            Int      @map("max_agents")
  maxMembers           Int      @map("max_members")
  maxTrainingBytes     BigInt   @map("max_training_bytes") // per agent
  apiAccess            Boolean  @map("api_access")
  paddlePriceIdMonthly String?  @map("paddle_price_id_monthly")
  paddlePriceIdYearly  String?  @map("paddle_price_id_yearly")
  createdAt            DateTime @default(now()) @map("created_at")

  subscriptions WorkspaceSubscription[]

  @@map("plans")
}

model WorkspaceSubscription {
  id                   String   @id @default(cuid())
  workspaceId          Int      @unique @map("workspace_id")
  planId               String   @map("plan_id")
  paddleCustomerId     String?  @map("paddle_customer_id")
  paddleSubscriptionId String?  @map("paddle_subscription_id")
  status               String   // active | canceled | past_due | trialing
  billingCycle         String   @map("billing_cycle") // monthly | yearly
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@map("workspace_subscriptions")
}

model WorkspaceBillingTransaction {
  id                  String   @id @default(cuid())
  workspaceId         Int      @map("workspace_id")
  paddleTransactionId String   @map("paddle_transaction_id")
  amountCents         Int?     @map("amount_cents")
  currencyCode        String?  @map("currency_code")
  status              String   @default("completed")
  createdAt           DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, paddleTransactionId])
  @@map("workspace_billing_transactions")
}

model WorkspaceCredits {
  id              String   @id @default(cuid())
  workspaceId     Int      @unique @map("workspace_id")
  includedCredits Int      @map("included_credits") // resets monthly from plan
  bonusCredits    Int      @default(0) @map("bonus_credits") // non-expiring purchased
  usedCredits     Int      @default(0) @map("used_credits") // resets monthly
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_credits")
}

model WorkspaceApiKey {
  id        String    @id @default(cuid())
  workspaceId Int     @map("workspace_id")
  name      String    @map("name")
  keyHash   String    @unique @map("key_hash")
  keyPrefix String    @map("key_prefix") // first 12 chars for display
  lastUsedAt DateTime? @map("last_used_at")
  createdById Int     @map("created_by_id")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("workspace_api_keys")
}

model CheckoutContext {
  id          Int      @id @default(autoincrement())
  userEmail   String   @unique @map("user_email")
  workspaceId Int      @map("workspace_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("checkout_context")
}
