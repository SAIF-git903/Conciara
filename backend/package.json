{
  "name": "dialog-tree-backend",
  "version": "1.0.0",
  "description": "Backend API for Dialog Tree Manager",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "setup-db": "tsx src/db/setup.ts",
    "update-vector": "tsx src/db/updateVectorColumn.ts",
    "seed": "tsx src/db/seed.ts",
    "regenerate-embeddings": "tsx src/regenerateEmbeddings.ts"
  },
  "keywords": ["dialog", "tree", "api"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "openai": "^4.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

