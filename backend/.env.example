# Database (use DATABASE_URL or DB_*)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dialog_trees

# Server
# PORT=3001
# Set to true when behind a reverse proxy (Heroku, AWS, etc.) so rate limits use real client IP
# TRUST_PROXY=true

# Rate limiting (optional; defaults shown)
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_GENERAL_MAX=200
# RATE_LIMIT_CHAT_WINDOW_MS=60000
# RATE_LIMIT_CHAT_MAX=30

# Auth
# JWT_SECRET=your-jwt-secret

# Paddle Billing (plans / subscriptions)
# API key from Paddle Dashboard (optional; used if you call Paddle API from backend)
# PADDLE_API_KEY=
# Webhook secret from Developer Tools → Notifications → your destination → Secret key (required for webhooks)
# PADDLE_WEBHOOK_SECRET=
# Optional: set to 1 for local testing with ngrok so webhooks are accepted without signature verification (insecure; do not use in production)
# PADDLE_WEBHOOK_SKIP_VERIFY=

# Frontend (for redirects, invite links)
# FRONTEND_URL=http://localhost:3002

# OpenAI (chat / embeddings)
# OPENAI_API_KEY=

# Optional: Slack, SMTP, S3, etc.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_REDIRECT_URI=
