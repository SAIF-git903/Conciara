# API base URL (backend)
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Paddle checkout — use one of:
# (A) Hosted Checkout URL: redirect to your Paddle hosted checkout with ?price_id= (no custom_data in webhook).
NEXT_PUBLIC_PADDLE_HOSTED_CHECKOUT_URL=
# (B) Overlay (Paddle.js): client token + set default payment link in Paddle → Checkout → Checkout settings.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
