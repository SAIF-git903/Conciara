# Public API base URL used by the frontend app.
# Example: http://localhost:3001/api
NEXT_PUBLIC_API_URL=

# Paddle checkout configuration.
# Use ONE approach:
# - Hosted checkout: set NEXT_PUBLIC_PADDLE_HOSTED_CHECKOUT_URL
# - Overlay checkout: set NEXT_PUBLIC_PADDLE_CLIENT_TOKEN (+ optional NEXT_PUBLIC_PADDLE_ENVIRONMENT)

# Hosted checkout URL (redirects to Paddle with ?price_id=).
NEXT_PUBLIC_PADDLE_HOSTED_CHECKOUT_URL=

# Overlay checkout client token from Paddle dashboard.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Paddle environment for overlay checkout: sandbox or production.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

