# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# You can use either DATABASE_URL or individual DB_* variables
# If both are set, DATABASE_URL takes precedence
DB_USER=db_tester
DB_PASSWORD=my_database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dialog_trees

# Alternative: Use DATABASE_URL instead of individual variables
# DATABASE_URL=postgresql://db_tester:my_database@localhost:5432/dialog_trees

# OpenAI API Key (required for vector embeddings)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
